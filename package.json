{
  "name": "pairlan",
  "version": "0.2.1",
  "description": "Chat e compartilhamento de tela em rede local para pair programming",
  "main": "out/main/index.js",
  "author": "Ueslei Nascimento",
  "license": "MIT",
  "homepage": "https://github.com/uesleinasch/pairlan",
  "scripts": {
    "dev": "npm run icons && electron-vite dev --noSandbox -- --ozone-platform=x11",
    "build": "npm run icons && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder --linux AppImage",
    "pair": "npm run build && node scripts/pair.mjs",
    "theme": "node scripts/theme.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/web": "^2.5.0",
    "material-symbols": "^0.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  }
}
