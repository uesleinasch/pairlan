{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pairlan-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "USERS", "class_name": "UserDO" },
      { "name": "ROOMS", "class_name": "RoomDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "RoomDO"] }],
  "ratelimits": [
    { "name": "REGISTER_LIMITER", "namespace_id": "4780", "simple": { "limit": 10, "period": 60 } },
    { "name": "PAIR_LIMITER", "namespace_id": "4781", "simple": { "limit": 30, "period": 60 } }
  ]
}
